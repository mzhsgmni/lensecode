# lensecode environment variables
# Kopyala: cp .env.example .env  (Windows: copy .env.example .env)
# Sonra aşağıdaki değerleri KENDİ değerlerinle doldur.

# ── Giriş şifresi ────────────────────────────────────────────
# Uygulamaya giriş için kullanılır. Güçlü bir şifre belirle.
LENSCODE_PASSWORD=

# ── JWT imzalama anahtarı (ZORUNLU, en az 32 bayt) ───────────
# Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Token geçerlilik süresi (gün)
TOKEN_EXPIRY_DAYS=7

# ── LLM API anahtarları (opsiyonel) ──────────────────────────
# Boş kalırsa AI analizi şablon tabanlı fallback modunda çalışır.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# ── CORS ─────────────────────────────────────────────────────
# Frontend origin'leri, virgülle ayır. Boş bırakılırsa "*" (tümü) kabul edilir.
CORS_ORIGINS=http://localhost:3000

# ── Güvenlik taraması ────────────────────────────────────────
# 1 = Semgrep (kuruluysa) + yerleşik tarayıcı, 0 = sadece yerleşik tarayıcı
ENABLE_SEMGREP=1
# auto = semgrep registry kuralları (internet gerekir), p/default vb. de olabilir
SEMGREP_CONFIG=auto

# ── Site adresi (SEO için ZORUNLU) ───────────────────────────
# Yayınlandiktan sonra gercek adresi yazin. Open Graph, canonical,
# sitemap ve paylasim kartlari bu degerden uretilir.
NEXT_PUBLIC_SITE_URL=https://lensecode-ornek.vercel.app

# ── Railway (opsiyonel) ──────────────────────────────────────
# Railway servis domaini; backend otomatik olarak https://<domain> CORS'a ekler.
# RAILWAY_PUBLIC_DOMAIN=
# Frontend servisinde backend'e erişim için:
# BACKEND_URL=https://<backend-domain>.up.railway.app
